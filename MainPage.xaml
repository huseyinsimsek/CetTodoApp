<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CetTodoApp"
             x:Class="CetTodoApp.MainPage"
             BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ColorConverter x:Key="MyColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Yapılacaklar Listesi" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#512BD4"/>

            <Entry x:Name="TitleEntry" 
                   Placeholder="Görev adı giriniz..."
                   HeightRequest="50"/>

            <DatePicker x:Name="MyDatePicker" />

            <Button Text="Ekle" 
                    Clicked="OnAddClicked" 
                    BackgroundColor="#512BD4" 
                    TextColor="White"
                    CornerRadius="8"/>
        </VerticalStackLayout>

        <ListView Grid.Row="1" 
                  ItemsSource="{Binding TodoItems}" 
                  Margin="0,20,0,0"
                  HasUnevenRows="True"
                  SeparatorColor="LightGray">
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid ColumnDefinitions="Auto, *" Padding="10">
                            
                            <CheckBox Grid.Column="0" 
                                      IsChecked="{Binding IsCompleted}" 
                                      VerticalOptions="Center"
                                      Color="#512BD4"/>
                            
                            <StackLayout Grid.Column="1" Padding="10,0,0,0" VerticalOptions="Center">
                                
                                <Label Text="{Binding Title}" 
                                       FontSize="18" 
                                       FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="DueDate" Converter="{StaticResource MyColorConverter}" />
                                    </Label.TextColor>
                                    
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                
                                <Label Text="{Binding DueDate, StringFormat='Tarih: {0:dd/MM/yyyy}'}" 
                                       FontSize="14" 
                                       TextColor="Gray"/>
                            </StackLayout>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>

</ContentPage>